{
    "dependencies": {
        "bluetooth": "*",
        "core": "*"
    },
    "description": "Scratch2Maqueen firmware for micro:bit V1 and V2",
    "files": [
        "main.ts",
        "legacyble.d.ts",
        "legacyble.cpp",
        "README.md"
    ],
    "name": "scratch2maqueen-v2",
    "preferredEditor": "tsprj",
    "supportedTargets": [
        "microbit"
    ],
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "advertising_timeout": 0,
                    "device_info_service": 0,
                    "dfu_service": 0,
                    "enabled": 1,
                    "event_service": 0,
                    "open": 1,
                    "pairing_mode": 1,
                    "private_addressing": 0,
                    "security_level": "SECURITY_MODE_ENCRYPTION_NO_MITM",
                    "tx_power": 0,
                    "whitelist": 1
                },
                "gatt_table_size": "0x300"
            }
        }
    }
}
